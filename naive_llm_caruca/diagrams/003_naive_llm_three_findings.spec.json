[
 {"type": "text", "id": "title", "x": 40, "y": 24, "fs": 30, "stroke": "#1e40af",
  "text": "Three things the naive-LLM agent showed us about Caruca"},
 {"type": "text", "id": "subtitle", "x": 40, "y": 70, "fs": 15, "stroke": "#64748b",
  "text": "purple = written by a language model  ·  blue = Caruca's own files and code  ·  orange = the real command  ·  red = goes wrong  ·  green = works"},

 {"type": "text", "id": "r1n", "x": 40, "y": 132, "fs": 22, "stroke": "#1e40af",
  "text": "1  Ask the command,\n   not only its manual"},
 {"type": "text", "id": "r1b", "x": 40, "y": 205, "fs": 14, "stroke": "#64748b",
  "text": "Caruca's model reads only the\nmanual, and is told not to add\nanything the manual doesn't\nsay. The agent read the\nmanual, then ran the command."},

 {"type": "rectangle", "id": "book", "x": 390, "y": 175, "w": 200, "h": 76, "stroke": "#1e3a5f", "fill": "#93c5fd"},
 {"type": "text", "id": "bookt", "x": 490, "y": 194, "fs": 16, "stroke": "#374151", "align": "center",
  "text": "The manual\n(man page)"},
 {"type": "rectangle", "id": "sheet", "x": 690, "y": 150, "w": 260, "h": 56, "stroke": "#6d28d9", "fill": "#ddd6fe"},
 {"type": "text", "id": "sheett", "x": 820, "y": 159, "fs": 15, "stroke": "#374151", "align": "center",
  "text": "Caruca's syntax file\nwritten by GPT-4o"},
 {"type": "rectangle", "id": "key", "x": 690, "y": 222, "w": 260, "h": 56, "stroke": "#1e3a5f", "fill": "#93c5fd"},
 {"type": "text", "id": "keyt", "x": 820, "y": 231, "fs": 15, "stroke": "#374151", "align": "center",
  "text": "Reference file (answer\nkey), 80 person-hours"},
 {"type": "arrow", "id": "a_book_sheet", "x": 592, "y": 200, "points": [[0, 0], [96, -22]], "stroke": "#1e3a5f"},
 {"type": "arrow", "id": "a_book_key", "x": 592, "y": 226, "points": [[0, 0], [96, 24]], "stroke": "#1e3a5f"},
 {"type": "ellipse", "id": "match", "x": 1010, "y": 180, "w": 130, "h": 70, "stroke": "#b45309", "fill": "#fef3c7"},
 {"type": "text", "id": "matcht", "x": 1075, "y": 205, "fs": 16, "stroke": "#374151", "align": "center",
  "text": "match?"},
 {"type": "arrow", "id": "a_sheet_match", "x": 952, "y": 178, "points": [[0, 0], [60, 27]], "stroke": "#6d28d9"},
 {"type": "arrow", "id": "a_key_match", "x": 952, "y": 250, "points": [[0, 0], [60, -25]], "stroke": "#1e3a5f"},
 {"type": "ellipse", "id": "score", "x": 1185, "y": 180, "w": 150, "h": 70, "stroke": "#047857", "fill": "#a7f3d0"},
 {"type": "text", "id": "scoret", "x": 1260, "y": 196, "fs": 15, "stroke": "#374151", "align": "center",
  "text": "scored:\nmatch"},
 {"type": "arrow", "id": "a_match_score", "x": 1142, "y": 215, "points": [[0, 0], [41, 0]], "stroke": "#b45309"},
 {"type": "text", "id": "blind", "x": 1365, "y": 150, "fs": 14, "stroke": "#b91c1c",
  "text": "Both come from the same manual,\nso they share its blind spots.\ngrep takes its pattern 3 ways;\nboth files hold only 1, and\nstill score as a match."},

 {"type": "rectangle", "id": "agent", "x": 390, "y": 350, "w": 200, "h": 80, "stroke": "#6d28d9", "fill": "#ddd6fe"},
 {"type": "text", "id": "agentt", "x": 490, "y": 364, "fs": 14, "stroke": "#374151", "align": "center",
  "text": "Agent (naive LLM)\nreads the manual, then\nruns the command"},
 {"type": "arrow", "id": "a_book_agent", "x": 490, "y": 253, "points": [[0, 0], [0, 95]], "stroke": "#1e3a5f"},
 {"type": "rectangle", "id": "cmd", "x": 690, "y": 350, "w": 260, "h": 80, "stroke": "#c2410c", "fill": "#fed7aa"},
 {"type": "text", "id": "cmdt", "x": 820, "y": 371, "fs": 15, "stroke": "#374151", "align": "center",
  "text": "The command itself\n(rm, convert, binwalk)"},
 {"type": "arrow", "id": "a_try", "x": 592, "y": 375, "points": [[0, 0], [96, 0]], "stroke": "#6d28d9"},
 {"type": "arrow", "id": "a_reply", "x": 688, "y": 405, "points": [[0, 0], [-96, 0]], "stroke": "#c2410c"},
 {"type": "text", "id": "tryt", "x": 640, "y": 354, "fs": 12, "stroke": "#64748b", "align": "center", "text": "tries"},
 {"type": "text", "id": "replyt", "x": 640, "y": 410, "fs": 12, "stroke": "#64748b", "align": "center", "text": "replies"},
 {"type": "text", "id": "termlab", "x": 990, "y": 312, "fs": 13, "stroke": "#64748b",
  "text": "rm's own reply, from the run-5 log:"},
 {"type": "rectangle", "id": "term", "x": 990, "y": 334, "w": 420, "h": 126, "stroke": "#1e293b", "fill": "#1e293b"},
 {"type": "text", "id": "termt", "x": 1004, "y": 346, "fs": 13, "stroke": "#22c55e",
  "text": "$ rm --interactive=bogus a\nrm: invalid argument ‘bogus’ for ‘--interactive’\nValid arguments are:\n  - ‘never’, ‘no’, ‘none’\n  - ‘once’\n  - ‘always’, ‘yes’"},
 {"type": "arrow", "id": "a_cmd_term", "x": 952, "y": 395, "points": [[0, 0], [36, 0]], "stroke": "#c2410c"},
 {"type": "text", "id": "foundh", "x": 1435, "y": 318, "fs": 14, "stroke": "#047857",
  "text": "Found only by running it:"},
 {"type": "text", "id": "found", "x": 1435, "y": 340, "fs": 14, "stroke": "#374151",
  "text": "rm: 6 accepted values;\n  the manual lists 3\nconvert: 10+ working options\n  the manual lacks, and 1 it\n  lists that doesn't exist\nbinwalk: manual is for an\n  older version; lacks 2"},

 {"type": "line", "id": "div1", "x": 40, "y": 505, "points": [[0, 0], [1700, 0]], "stroke": "#64748b", "sw": 1, "style": "dashed"},

 {"type": "text", "id": "r2n", "x": 40, "y": 527, "fs": 22, "stroke": "#1e40af",
  "text": "2  Many test command\n   lines do nothing"},
 {"type": "text", "id": "r2b", "x": 40, "y": 600, "fs": 14, "stroke": "#64748b",
  "text": "Caruca turns a syntax file\ninto thousands of command\nlines and runs each one in\na sandbox, recording every\nfile it touches. Many are\nrefused by the command, or\ngive it nothing to work on."},

 {"type": "text", "id": "srcA", "x": 390, "y": 549, "fs": 14, "stroke": "#374151",
  "text": "convert: Caruca's\nreference file\n(default settings)"},
 {"type": "rectangle", "id": "boxA", "x": 600, "y": 548, "w": 300, "h": 56, "stroke": "#1e3a5f", "fill": "#93c5fd"},
 {"type": "text", "id": "boxAt", "x": 750, "y": 566, "fs": 16, "stroke": "#374151", "align": "center",
  "text": "1,052 command lines"},
 {"type": "arrow", "id": "a_A", "x": 902, "y": 576, "points": [[0, 0], [86, 0]], "stroke": "#1e3a5f"},
 {"type": "ellipse", "id": "zeroA", "x": 990, "y": 548, "w": 120, "h": 56, "stroke": "#b91c1c", "fill": "#fecaca"},
 {"type": "text", "id": "zeroAt", "x": 1050, "y": 562, "fs": 22, "stroke": "#b91c1c", "align": "center", "text": "0"},
 {"type": "text", "id": "noteA", "x": 1135, "y": 550, "fs": 14, "stroke": "#64748b",
  "text": "have both an image to read and a file to write.\nEach names one file: convert -resize 50% f.jpg\nanswers \"no images defined\" and writes nothing."},

 {"type": "text", "id": "srcB", "x": 390, "y": 672, "fs": 14, "stroke": "#374151",
  "text": "cut: the agent's\nsyntax file"},
 {"type": "rectangle", "id": "boxB", "x": 600, "y": 663, "w": 300, "h": 56, "stroke": "#6d28d9", "fill": "#ddd6fe"},
 {"type": "text", "id": "boxBt", "x": 750, "y": 681, "fs": 16, "stroke": "#374151", "align": "center",
  "text": "13,222 command lines"},
 {"type": "arrow", "id": "a_B", "x": 902, "y": 691, "points": [[0, 0], [86, 0]], "stroke": "#6d28d9"},
 {"type": "ellipse", "id": "zeroB", "x": 990, "y": 663, "w": 120, "h": 56, "stroke": "#b91c1c", "fill": "#fecaca"},
 {"type": "text", "id": "zeroBt", "x": 1050, "y": 677, "fs": 22, "stroke": "#b91c1c", "align": "center", "text": "0"},
 {"type": "text", "id": "noteB", "x": 1135, "y": 656, "fs": 14, "stroke": "#64748b",
  "text": "do real work. Its file yields lines like\ncut -d=a, which cut refuses: a habit copied\nfrom Caruca's own example file (uniq).\nCaruca's reference: 360 of 11,651."},

 {"type": "text", "id": "srcC", "x": 390, "y": 787, "fs": 14, "stroke": "#374151",
  "text": "binwalk: Caruca's\ntest-file pool"},
 {"type": "rectangle", "id": "boxC", "x": 600, "y": 778, "w": 300, "h": 56, "stroke": "#1e3a5f", "fill": "#93c5fd"},
 {"type": "text", "id": "boxCt", "x": 750, "y": 796, "fs": 16, "stroke": "#374151", "align": "center",
  "text": "8 files: text, JSON, a photo"},
 {"type": "arrow", "id": "a_C", "x": 902, "y": 806, "points": [[0, 0], [86, 0]], "stroke": "#1e3a5f"},
 {"type": "ellipse", "id": "zeroC", "x": 990, "y": 778, "w": 120, "h": 56, "stroke": "#b91c1c", "fill": "#fecaca"},
 {"type": "text", "id": "zeroCt", "x": 1050, "y": 792, "fs": 22, "stroke": "#b91c1c", "align": "center", "text": "0"},
 {"type": "text", "id": "noteC", "x": 1135, "y": 780, "fs": 14, "stroke": "#64748b",
  "text": "hold anything for binwalk to find. It looks for\nfiles hidden inside files; in the photo it\nfinds only the photo itself."},

 {"type": "text", "id": "fix", "x": 390, "y": 858, "fs": 15, "stroke": "#047857",
  "text": "Cheap fix: run each command line once, quickly, before tracing, and drop the ones the command refuses."},

 {"type": "line", "id": "div2", "x": 40, "y": 897, "points": [[0, 0], [1700, 0]], "stroke": "#64748b", "sw": 1, "style": "dashed"},

 {"type": "text", "id": "r3n", "x": 40, "y": 919, "fs": 22, "stroke": "#1e40af",
  "text": "3  Inventive, but a\n   poor judge of its\n   own work"},
 {"type": "text", "id": "r3b", "x": 40, "y": 1020, "fs": 14, "stroke": "#64748b",
  "text": "No one told it how to test.\nIt invented good tests, then\ntrusted its own report."},

 {"type": "text", "id": "cleverh", "x": 390, "y": 919, "fs": 16, "stroke": "#047857",
  "text": "Inventive: unprompted, it rebuilt Caruca's split test"},
 {"type": "rectangle", "id": "file", "x": 390, "y": 985, "w": 100, "h": 110, "stroke": "#1e3a5f", "fill": "#93c5fd"},
 {"type": "text", "id": "filet", "x": 440, "y": 1012, "fs": 15, "stroke": "#374151", "align": "center",
  "text": "one\nbig\nfile"},
