{
  "name": "caruca-console",
  "version": "0.1.0",
  "private": true,
  "description": "Local execution console for caruca_v2: v1 and v2 side by side. Never deployed; binds to 127.0.0.1 only.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
