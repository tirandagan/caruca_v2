# caruca_v2 environment. Copy to .env (which is gitignored) and fill in.

# Single API key: every candidate model is reached through the OpenRouter gateway.
OPENROUTER_API_KEY=

# Path to the caruca v1 checkout (the repo root, i.e. the directory containing `caruca/`).
# Per-machine: the Mac default is shown; on the WSL PC it is ~/stevens/caruca.
CARUCA_V1_ROOT=/Users/tirandagan/dev/stevens/caruca

# Set to 1 to write conversation.jsonl into every run directory (same as --log-conversation).
CARUCA_V2_LOG_CONVERSATION=0
